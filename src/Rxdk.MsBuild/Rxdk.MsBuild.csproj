<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Rxdk.MsBuild</AssemblyName>
    <RootNamespace>Rxdk.MsBuild</RootNamespace>
    <ProjectGuid>{72C2CD82-4280-44FE-B5C9-8362611DC6F9}</ProjectGuid>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <!-- Keep the existing hand-written Properties\AssemblyInfo.cs (no SDK-generated one). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Output stays at bin\<Config>\ (no TFM subfolder) so the VSIX packaging, the
         RxdkCopyToApplicationType copy below, and the reflection check all keep finding
         bin\Debug\Rxdk.MsBuild.dll exactly where they did under the old legacy project. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <!-- We ship only our own assembly; MSBuild supplies its base assemblies at runtime. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- The MSBuild task base comes from version-stable NuGet packages, NOT a per-Visual-Studio
       $(VCTargetsPath) assembly. Deriving the tasks from Microsoft.Build.Utilities.Task (17.3.2)
       instead of the per-VS Microsoft.Build.CPPTasks.Common TrackedVCToolTask lets ONE net472
       Rxdk.MsBuild.dll load under VS2022 (v170) and VS "18"/v180 alike. ExcludeAssets=runtime
       keeps these out of the output; the host MSBuild supplies them at runtime. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="17.3.2" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.3.2" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- RXDK\Current\Rxdk.MsBuild.dll is the ApplicationType-visible copy the VSIX packages
       (RxdkVs.Package.csproj: Content Include="...\Rxdk.MsBuild\RXDK\**\*") and that
       Install Xbox Platform stages into VCTargetsPath\Application Type\RXDK\Current\: it must be
       a real file next to Rxdk.MsBuild.props/.targets. Rebuilt on every build so it never goes stale. -->
  <Target Name="RxdkCopyToApplicationType" AfterTargets="Build">
    <ItemGroup>
      <RxdkAppTypeDllOutput Include="$(OutputPath)Rxdk.MsBuild.dll" />
      <RxdkAppTypeDllOutput Include="$(OutputPath)Rxdk.MsBuild.pdb" Condition="Exists('$(OutputPath)Rxdk.MsBuild.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(RxdkAppTypeDllOutput)" DestinationFolder="$(MSBuildProjectDirectory)\RXDK\Current" SkipUnchangedFiles="true" />
  </Target>

</Project>
