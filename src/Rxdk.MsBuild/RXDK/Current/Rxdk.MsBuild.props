<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Project="$(MSBuildThisFileDirectory)ImportBefore\*.props" Condition="Exists('$(MSBuildThisFileDirectory)ImportBefore')" />

    <PropertyGroup>
        <EnableStdModules>false</EnableStdModules>
        <!-- The MultiToolTask path (Rxdk.MsBuild.targets' ClCompile target, when this is true) is
             Microsoft's own multi-proc cl.exe orchestrator: even when pointed at ZigCompile via
             TaskName, it independently adds the real MSVC/Windows SDK include dirs on top of
             whatever %(ClCompile.AdditionalIncludeDirectories) says, which a freestanding clang
             build can't tolerate (redeclared builtins, __crt_va_start/end undeclared, etc). The
             plain per-source ZigCompile invocations further down the same target honor our
             AdditionalIncludeDirectories override exactly, so force that path always. -->
        <UseMultiToolTask>false</UseMultiToolTask>
        <IncludePath>$(RXDK)\sdk\include\c++\v1;$(RXDK)\sdk\include</IncludePath>
        <!-- A second, dedicated copy of the same paths: Microsoft.Cpp.targets (imported after this
             file, at the bottom of the .vcxproj) redefines $(IncludePath) itself as
             $(VC_IncludePath);$(WindowsSDK_IncludePath);... with %(IncludePath) folded in: it
             appends the real MSVC/Windows SDK dirs onto ours rather than the other way around, so by
             the time the ClCompile target runs, $(IncludePath) is no longer just the SDK's own
             clean-room headers. This name is ours alone, so nothing downstream touches it. -->
        <RxdkSdkIncludePath>$(RXDK)\sdk\include\c++\v1;$(RXDK)\sdk\include</RxdkSdkIncludePath>
        <!-- One flat dir, XDK-style: Debug and Release variants of a library live side by side,
             distinguished by a "d" suffix on the filename (libxapi.lib / libxapid.lib) — picked
             by whatever names the project's own LibraryDependencies/AdditionalDependencies list,
             same as a real "Additional Dependencies" flow. Not chosen by this property. -->
        <LibraryPath>$(RXDK)\sdk\lib</LibraryPath>
        <!-- The classic XDK "$(D)" token: Debug appends it to every lib name below, Release
             leaves it empty, so the two configs pick libd3d8d.lib / libd3d8.lib etc. themselves —
             the engine never appends it on its own. -->
        <D Condition="'$(UseDebugLibraries)' == 'true'">d</D>
        <D Condition="'$(UseDebugLibraries)' != 'true'"></D>
        <NeedImageBld Condition="'$(ConfigurationType)' == 'Application' or '$(ConfigurationType)' == 'DebuggerExtension'">true</NeedImageBld>
        <!-- This happens because of how ImageBld is set up -->
        <MSBuildWarningsAsMessages Condition="'$(NeedImageBld)' != ''">$(MSBuildWarningsAsMessages);MSB8012</MSBuildWarningsAsMessages>
    </PropertyGroup>

    <PropertyGroup Condition="'$(DesignTimeBuild)' == 'true'">
        <!--<IncludePath>$(AdditionalIncludeDirectories);$(IncludePath);$(RXDK)\sdk\intellisense</IncludePath>-->
    </PropertyGroup>

    <!-- Specific values -->
    <PropertyGroup Condition="'$(ConfigurationType)' == 'Application'">
        <LinkCompiled>true</LinkCompiled>
        <TargetExt>.xbe</TargetExt>
        <OutputType>exe</OutputType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(ConfigurationType)' == 'DebuggerExtension'">
        <!-- A DXT is linked exactly like an Application (Zig, not archived with Lib/ar); imagebld
             /dxt afterward is what turns the linked executable into a flat PE, not the archiver.
             LibCompiled here was a bug: it routed DXT builds through the Lib/ar target instead of
             Link, producing a bogus .dxt "archive" and never actually linking against the SDK. -->
        <LinkCompiled>true</LinkCompiled>
        <TargetExt>.dxt</TargetExt>
        <OutputType>exe</OutputType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(ConfigurationType)' == 'StaticLibrary'">
        <LibCompiled>true</LibCompiled>
        <TargetExt>.lib</TargetExt>
        <OutputType>staticlibrary</OutputType>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <ClCompile>
            <WarningLevel>EnableAllWarnings</WarningLevel>
            <DebugInfo Condition="'$(UseDebugLibraries)' == 'true'">Full</DebugInfo>
            <DebugInfo Condition="'$(UseDebugLibraries)' != 'true'">LineTables</DebugInfo>
            <PreprocessorDefinitions Condition="'$(UseDebugLibraries)' != 'true'">NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
            <Optimization Condition="'$(UseDebugLibraries)' == 'true'">None</Optimization>
            <Optimization Condition="'$(UseDebugLibraries)' != 'true'">Full</Optimization>
            <ProgramDatabaseFileName Condition="'$(ConfigurationType)' != 'StaticLibrary'">$(IntDir)</ProgramDatabaseFileName>
            <ProgramDatabaseFileName Condition="'$(ConfigurationType)' == 'StaticLibrary'">$(OutDir)</ProgramDatabaseFileName>
            <OmitFramePointers Condition="'$(UseDebugLibraries)' == 'true'">false</OmitFramePointers>
            <OmitFramePointers Condition="'$(UseDebugLibraries)' != 'true'">true</OmitFramePointers>
            <ExceptionHandling>Enabled</ExceptionHandling>
            <FunctionLevelLinking Condition="'$(UseDebugLibraries)' == 'true'">false</FunctionLevelLinking>
            <FunctionLevelLinking Condition="'$(UseDebugLibraries)' != 'true'">true</FunctionLevelLinking>
            <DataLevelLinking Condition="'$(UseDebugLibraries)' == 'true'">false</DataLevelLinking>
            <DataLevelLinking Condition="'$(UseDebugLibraries)' != 'true'">true</DataLevelLinking>
            <BufferSecurityCheck>true</BufferSecurityCheck>
            <PositionIndependentCode>false</PositionIndependentCode>
            <UseShortEnums>false</UseShortEnums>
            <RuntimeTypeInfo>false</RuntimeTypeInfo>
            <CLanguageStandard>c23</CLanguageStandard>
            <CppLanguageStandard>c++23</CppLanguageStandard>
            <PrecompiledHeader>NotUsing</PrecompiledHeader>
            <ObjectFileName>$(IntDir)%(filename).obj</ObjectFileName>
            <CompileAs>Default</CompileAs>
            <TreatWarningAsError>false</TreatWarningAsError>
            <Verbose>false</Verbose>
            <EnablePREfast Condition="'%(ClCompile.EnablePREfast)' == ''">false</EnablePREfast>
            <OmitFramePointers Condition="'%(ClCompile.OmitFramePointers)' == ''">false</OmitFramePointers>
            <MinimalRebuildFromTracking>true</MinimalRebuildFromTracking>
            <PrecompiledHeaderOutputFileDirectory>$(IntDir)</PrecompiledHeaderOutputFileDirectory>
            <PrecompiledHeaderOutputFile></PrecompiledHeaderOutputFile>
            <PrecompiledHeaderCompileAs>CompileAsCpp</PrecompiledHeaderCompileAs>
            <ForcedIncludeFiles>picolibc.h</ForcedIncludeFiles>
        </ClCompile>

        <ClCompile Condition="'$(DesignTimeBuild)' == 'true'">
            <!--<ForcedIncludeFiles>rxdk_intellisense.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>-->
        </ClCompile>

        <Link>
            <OutputFile>$(OutDir)$(TargetName).exe</OutputFile>
            <EntryPointSymbol Condition="'$(ConfigurationType)' == 'Application'">XapiTitleStartup</EntryPointSymbol>
            <EntryPointSymbol Condition="'$(ConfigurationType)' == 'DebuggerExtension'">DxtEntry</EntryPointSymbol>
            <!-- LibraryDependencies maps to -lNAME. Verified against the real zig cc / ld.lld search
                 strategy on this target (x86-windows-gnu): -lNAME only tries NAME.dll, NAME.lib and
                 libNAME.a — never libNAME.lib, so with our libs actually named libd3d8d.lib etc
                 (the "lib" is part of the real filename, not an implied prefix), the -l value has to
                 spell that out in full: libd3d8$(D), not d3d8$(D). -->
            <LibraryDependencies>libd3d8$(D);libd3dx8$(D);libxapi$(D);libc$(D);libcpp$(D);libkernel$(D)</LibraryDependencies>
            <AdditionalDependencies />
            <!-- libcompat[d].lib is an explicit dependency like any other above, just force-linked
                 whole-archive (see XdkLink.cs's IsWholeArchiveLib for the matching Rxdk.Engine
                 logic and the hardware rationale) — projects name it themselves, same as this list. -->
            <AdditionalOptions>-rtlib=compiler-rt -Wl,--whole-archive -llibcompat$(D) -Wl,--no-whole-archive</AdditionalOptions>
        </Link>

        <ImageBld>
            <OutputFile>$(OutDir)$(TargetName)$(TargetExt)</OutputFile>
            <Dxt Condition="'$(ConfigurationType)' == 'DebuggerExtension'">true</Dxt>
            <Dxt Condition="'$(ConfigurationType)' != 'DebuggerExtension'">false</Dxt>
            <StackSize Condition="'%(ImageBld.StackSize)' == ''">65536</StackSize>
            <Debug Condition="'%(ImageBld.Debug)' == ''">$(UseDebugLibraries)</Debug>
            <NoLogo Condition="'%(ImageBld.NoLogo)' == ''">true</NoLogo>
            <NoLibWarn Condition="'%(ImageBld.NoLibWarn)' == ''">true</NoLibWarn>
            <LimitMemory Condition="'%(ImageBld.LimitMemory)' == ''">false</LimitMemory>
            <DontModifyHardDisk Condition="'%(ImageBld.DontModifyHardDisk)' == ''">false</DontModifyHardDisk>
            <DontMountUtilityDrive Condition="'%(ImageBld.DontMountUtilityDrive)' == ''">false</DontMountUtilityDrive>
            <FormatUtilityDrive Condition="'%(ImageBld.FormatUtilityDrive)' == ''">false</FormatUtilityDrive>
            <UtilityDriveClusterSize Condition="'%(ImageBld.UtilityDriveClusterSize)' == ''">Default</UtilityDriveClusterSize>
        </ImageBld>

        <Xiso>
            <OutputFile>$(OutDir)$(TargetName).iso</OutputFile>
        </Xiso>
    </ItemDefinitionGroup>

    <ItemGroup>
        <ImageBld Condition="'$(NeedImageBld)' != ''" Include="$(OutDir)$(TargetName).exe" />
    </ItemGroup>
    
    <ItemGroup Condition="'$(ConfigurationType)' == 'Application'">
        <IsoCopy Include="$(ProjectDir)Media\**" />
        <Xiso Include="$(OutDir)XISO" />
    </ItemGroup>

    <Import Project="$(MSBuildThisFileDirectory)ImportAfter\*.props" Condition="Exists('$(MSBuildThisFileDirectory)ImportAfter')" />
</Project>
