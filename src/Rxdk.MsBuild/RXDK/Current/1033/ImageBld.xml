<?xml version="1.0" encoding="utf-8"?>
<!--
  "Xbox Image" project property page (mirrors the original XDK's Xbox Image page). Surfaces the
  imagebld settings that produce the .xbe as editable, per-configuration %(ImageBld.*) item
  metadata persisted to the .vcxproj: the same item the ImageBld target batches over and passes
  to imagebld. Contributed via a PropertyPageSchema in Rxdk.MsBuild.targets.
-->
<Rule Name="XboxImage"
      DisplayName="Xbox Image"
      PageTemplate="tool"
      Description="imagebld settings used to build the Xbox .xbe."
      Order="30"
      xmlns="http://schemas.microsoft.com/build/2009/properties">

  <Rule.Categories>
    <Category Name="General" DisplayName="General" Description="Core XBE image settings." />
    <Category Name="UtilityDrive" DisplayName="Utility Drive" Description="Utility (Z:) drive behavior at launch." />
    <Category Name="Certificate" DisplayName="Certificate" Description="XBE certificate fields." />
    <Category Name="TitleInfo" DisplayName="Title Info" Description="Title identity and images." />
    <Category Name="Advanced" DisplayName="Advanced" Description="Advanced imagebld options." />
    <Category Name="Command Line"
              DisplayName="Command Line"
              Subtype="CommandLine" />
  </Rule.Categories>

  <!-- ItemType="ImageBld": these persist as %(ImageBld.*) item metadata, the same item the
       ImageBld target in Rxdk.MsBuild.targets batches over (Inputs="@(ImageBld);@(Link)"), not a
       flat property. Without this the property page would write $(StackSize) etc. as ordinary
       properties that the Task's %(ImageBld.StackSize)-style parameters never read. -->
  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" ItemType="ImageBld" HasConfigurationCondition="true" />
  </Rule.DataSource>

  <!-- ===== General ===== -->
  <StringProperty Name="StackSize" DisplayName="Stack Size"
                  Category="General"
                  Description="Title thread stack size in bytes. (/stack)" />

  <BoolProperty Name="Debug" DisplayName="Include Debug Info"
                Category="General"
                Description="Include the debug directory in the XBE so the debugger can resolve symbols. (/debug)" />

  <BoolProperty Name="NoLogo" DisplayName="Suppress Startup Banner"
                Category="General"
                Description="Do not print the imagebld banner. (/nologo)" />

  <BoolProperty Name="NoLibWarn" DisplayName="Disable Library Warnings"
                Category="General"
                Description="Suppress library-version warnings from imagebld. (/nolibwarn)" />

  <BoolProperty Name="LimitMemory" DisplayName="Limit Memory (64 MB)"
                Category="General"
                Description="Run the title as if the console has only 64 MB of RAM. (/limitmem)" />

  <!-- ===== Utility Drive ===== -->
  <BoolProperty Name="DontModifyHardDisk" DisplayName="Don't Modify Hard Disk"
                Category="UtilityDrive"
                Description="Prevent the title from modifying the retail hard disk layout. (/dontmodifyhd)" />

  <BoolProperty Name="DontMountUtilityDrive" DisplayName="Don't Mount Utility Drive"
                Category="UtilityDrive"
                Description="Do not mount the utility (Z:) drive at launch (/dontmountud).  Cannot be combined with Format Utility Drive." />

  <BoolProperty Name="FormatUtilityDrive" DisplayName="Format Utility Drive"
                Category="UtilityDrive"
                Description="Format the utility (Z:) drive at launch (/formatud).  Cannot be combined with Don't Mount Utility Drive." />

  <EnumProperty Name="UtilityDriveClusterSize" DisplayName="Utility Drive Cluster Size"
                Category="UtilityDrive"
                Description="Cluster size for the utility drive (/udcluster). Default lets imagebld choose.">
    <EnumValue Name="Default" DisplayName="Default" />
    <EnumValue Name="16KB" DisplayName="16 KB" />
    <EnumValue Name="32KB" DisplayName="32 KB" />
    <EnumValue Name="64KB" DisplayName="64 KB" />
    <EnumValue Name="128KB" DisplayName="128 KB" />
    <EnumValue Name="256KB" DisplayName="256 KB" />
  </EnumProperty>

  <!-- ===== Certificate ===== -->
  <StringProperty Name="TestId" DisplayName="Title ID"
                  Category="Certificate"
                  Description="XBE Title ID. (/TESTID) Decimal or 0x-hex." />

  <StringProperty Name="TestAltId" DisplayName="Alternate ID"
                  Category="Certificate"
                  Description="Alternate title ID for access by alternate images. (/TESTALTID) 'number' or 'number,key'." />

  <StringProperty Name="TestRegion" DisplayName="Xbox Game Region"
                  Category="Certificate"
                  Description="Allowed regions bitmask. (/TESTREGION) 1=North America, 2=Japan, 4=Rest of World, 0x80000000=Manufacturing." />

  <StringProperty Name="TestRatings" DisplayName="Xbox Game Rating"
                  Category="Certificate"
                  Description="Ratings value. (/TESTRATINGS)" />

  <StringProperty Name="TestMediaTypes" DisplayName="Media Types"
                  Category="Certificate"
                  Description="Allowed media types bitmask. (/TESTMEDIATYPES)" />

  <StringProperty Name="TestLanKey" DisplayName="LAN Key"
                  Category="Certificate"
                  Description="LAN key for this image. (/TESTLANKEY)" />

  <StringProperty Name="TestSignKey" DisplayName="Sign Key"
                  Category="Certificate"
                  Description="Signature key for this image. (/TESTSIGNKEY)" />

  <!-- ===== Title Info ===== -->
  <StringProperty Name="TestName" DisplayName="Title Name"
                  Category="TitleInfo"
                  Description="Title name baked into the XBE certificate. (/TESTNAME)" />

  <StringProperty Name="TestVersion" DisplayName="XBE Version"
                  Category="TitleInfo"
                  Description="Title version number. (/TESTVERSION)" />

  <StringProperty Name="TitleInfo" DisplayName="Title Info File"
                  Subtype="file" Category="TitleInfo"
                  Description="Project-relative title info file. (/TITLEINFO)" />

  <StringProperty Name="TitleImage" DisplayName="Title Image"
                  Subtype="file" Category="TitleInfo"
                  Description="Project-relative title image in XPR format. (/TITLEIMAGE)" />

  <StringProperty Name="DefaultSaveImage" DisplayName="Save Game Image"
                  Subtype="file" Category="TitleInfo"
                  Description="Project-relative default save image in XPR format. (/DEFAULTSAVEIMAGE)" />

  <!-- ===== Advanced ===== -->
  <StringListProperty Name="NoPreload" DisplayName="Suppress Preloading"
                      Category="Advanced" Separator=";"
                      Description="Section names that should NOT be preloaded at launch (/nopreload). One entry per section." />
  <StringProperty
     Name="AdditionalOptions"
     DisplayName="Additional Options"
     Description="Additional Options."
     Category="Command Line"
     F1Keyword="vc.project.AdditionalOptionsPage">
  </StringProperty>

</Rule>
