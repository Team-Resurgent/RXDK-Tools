<?xml version="1.0" encoding="utf-8"?>
<Rule Name="CL"
      DisplayName="C/C++"
      SwitchPrefix="-"
      Order="10"
      PageTemplate="tool"
      xmlns="http://schemas.microsoft.com/build/2009/properties"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib" >
    <Rule.Categories>
        <Category
           Name="General"
           DisplayName="General" />
        <Category
           Name="Optimization"
           DisplayName="Optimization" />
        <Category
           Name="Preprocessor"
           DisplayName="Preprocessor" />
        <Category
           Name="Code Generation"
           DisplayName="Code Generation" />
        <Category
           Name="Language"
           DisplayName="Language" />
        <Category
           Name="Precompiled Headers"
           DisplayName="Precompiled Headers" />
        <Category
           Name="Advanced"
           DisplayName="Advanced" />
        <Category
           Name="All Options"
           DisplayName="All Options"
           Subtype="Search" />
        <Category
           Name="Command Line"
           DisplayName="Command Line"
           Subtype="CommandLine" />
    </Rule.Categories>
    <Rule.DataSource>
        <DataSource
           Persistence="ProjectFile"
           ItemType="ClCompile"
           Label=""
           HasConfigurationCondition="true" />
    </Rule.DataSource>
    <EnumProperty Name="Optimization"
                  DisplayName="Optimization"
                  Description="Specifies the optimization level for the title."
                  Category="Optimization" >
        <EnumValue Name="None"
                   Switch="O0 -fno-sanitize=undefined" />
        <EnumValue Name="FavorSpeed"
                   DisplayName="Favor Speed"
                   Switch="O2 -fno-sanitize=undefined" />
        <EnumValue Name="FavorSize"
                   DisplayName="Favor Size"
                   Switch="Os -fno-sanitize=undefined" />
        <EnumValue Name="Full"
                   Switch="O3 -fno-sanitize=undefined" />
    </EnumProperty>
    <StringProperty Name="AdditionalIncludeDirectories"
                    DisplayName="Additional Include Directories"
                    Description="Specifies one or more directories to add to the include path; separate with semi-colons if more than one. (-I[path])."
                    Switch="I "
                    Category="General" />
    <EnumProperty Name="DebugInfo"
                  DisplayName="Debug Information"
                  Description="Specifies the type of debugging information generated by the compiler."
                  Category="General" >
        <EnumValue Name="None" />
        <EnumValue Name="LineTables"
                   DisplayName="Line Tables Only"
                   Switch="gline-tables-only" />
        <EnumValue Name="Full"
                   Switch="g" />
    </EnumProperty>
    <StringProperty Name="ObjectFileName"
                    DisplayName="Object File Name"
                    Description="Specifies a name to override the default object file name; can be file or directory name. (-o [name])."
                    Switch="o "
                    Visible="false"
                    Category="General" />
    <EnumProperty Name="WarningLevel"
                  DisplayName="Warning Level"
                  Description="Select how strict you want the compiler to be about code errors.  Other flags should be added directly to Additional Options. (-w, -Wall)."
                  Category="General" >
        <EnumValue Name="TurnOffAllWarnings"
                   DisplayName="Turn Off All Warnings"
                   Switch="w" />
        <EnumValue Name="EnableDefaultWarnings"
                   DisplayName="Enable Default Warnings" />
        <EnumValue Name="EnableAllWarnings"
                   DisplayName="Enable All Warnings"
                   Switch="Wall" />
        <EnumValue Name="EnableExtraWarnings"
                   DisplayName="Enable Extra Warnings"
                   Switch="Wall -Wextra" />
    </EnumProperty>
    <BoolProperty Name="TreatWarningAsError"
                  DisplayName="Treat Warnings As Errors"
                  Description="Treats all compiler warnings as errors. For a new project, it may be best to use -Werror in all compilations; resolving all warnings will ensure the fewest possible hard-to-find code defects."
                  Switch="Werror"
                  Category="General" />
    <BoolProperty Name="Verbose"
                  DisplayName="Enable Verbose mode"
                  Description="Show commands to run and use verbose output."
                  Switch="v"
                  Category="Advanced" />
    <BoolProperty Name="OmitFramePointers"
                  DisplayName="Omit Frame Pointer"
                  Description="Suppresses creation of frame pointers on the call stack."
                  Switch="fomit-frame-pointer"
                  Category="Code Generation" />
    <BoolProperty Name="FunctionLevelLinking"
                  DisplayName="Enable Function-Level Linking"
                  Description="Allows the compiler to package individual functions in the form of packaged functions (COMDATs). Required for edit and continue to work.     (ffunction-sections)."
                  Switch="ffunction-sections"
                  Category="Code Generation" />
    <BoolProperty Name="DataLevelLinking"
                  DisplayName="Enable Data-Level Linking"
                  Description="Enables linker optimizations to remove unused data by emitting each data item in a separate section."
                  Switch="fdata-sections" 
                  Category="Optimization" />
    <BoolProperty Name="RuntimeTypeInfo"
                  DisplayName="Enable Run-Time Type Information"
                  Description="Adds code for checking C++ object types at run time (runtime type information).     (frtti, fno-rtti)"
                  Switch="frtti"
                  ReverseSwitch="fno-rtti"
                  Category="Code Generation" />
    <EnumProperty Name="CLanguageStandard"
                  DisplayName="C Language Standard"
                  Description="Determines the C language standard."
                  Category="Language" >
        <EnumValue Name="Default" />
        <EnumValue Name="c89"
                   DisplayName="C89"
                   Switch="std=c89" />
        <EnumValue Name="iso9899:199409"
                   DisplayName="ISO9899:199409"
                   Switch="std=iso9899:199409" />
        <EnumValue Name="gnu89"
                   DisplayName="C89 (GNU extensions)"
                   Switch="std=gnu89" />
        <EnumValue Name="c99"
                   DisplayName="C99"
                   Switch="std=c99" />
        <EnumValue Name="gnu99"
                   DisplayName="C99 (GNU extensions)"
                   Switch="std=gnu99" />
        <EnumValue Name="c11"
                   DisplayName="C11"
                   Switch="std=c11" />
        <EnumValue Name="gnu11"
                   DisplayName="C11 (GNU extensions)"
                   Switch="std=gnu11" />
        <EnumValue Name="c17"
                   DisplayName="C17"
                   Switch="std=c17" />
        <EnumValue Name="gnu17"
                   DisplayName="C17 (GNU extensions)"
                   Switch="std=gnu17" />
        <EnumValue Name="c23"
                   DisplayName="C23"
                   Switch="std=c23" />
        <EnumValue Name="gnu23"
                   DisplayName="C23 (GNU extensions)"
                   Switch="std=gnu23" />
        <EnumValue Name="c2y"
                   DisplayName="C2Y"
                   Switch="std=c2y" />
        <EnumValue Name="gnu2y"
                   DisplayName="C2Y (GNU extensions)"
                   Switch="std=gnu2y" />
    </EnumProperty>
    <EnumProperty Name="CppLanguageStandard"
                  DisplayName="C++ Language Standard"
                  Description="Determines the C++ language standard."
                  Category="Language" >
        <EnumValue Name="Default" />
        <EnumValue Name="c++98"
                   DisplayName="C++98"
                   Switch="std=c++98" />
        <EnumValue Name="gnu++98"
                   DisplayName="C++98 (GNU extensions)"
                   Switch="std=gnu++98" />
        <EnumValue Name="c++11"
                   DisplayName="C++11"
                   Switch="std=c++11" />
        <EnumValue Name="gnu++11"
                   DisplayName="C++11 (GNU extensions)"
                   Switch="std=gnu++11" />
        <EnumValue Name="c++14"
                   DisplayName="C++14"
                   Switch="std=c++14" />
        <EnumValue Name="gnu++14"
                   DisplayName="C++14 (GNU extensions)"
                   Switch="std=gnu++14" />
        <EnumValue Name="c++17"
                   DisplayName="C++17"
                   Switch="std=c++17" />
        <EnumValue Name="gnu++17"
                   DisplayName="C++17 (GNU extensions)"
                   Switch="std=gnu++17" />
        <EnumValue Name="c++20"
                   DisplayName="C++20"
                   Switch="std=c++20" />
        <EnumValue Name="gnu++20"
                   DisplayName="C++20 (GNU extensions)"
                   Switch="std=gnu++20" />
        <EnumValue Name="c++23"
                   DisplayName="C++23"
                   Switch="std=c++23" />
        <EnumValue Name="gnu++23"
                   DisplayName="C++23 (GNU extensions)"
                   Switch="std=gnu++23" />
        <EnumValue Name="c++2c"
                   DisplayName="C++2C (C++26)"
                   Switch="std=c++2c" />
        <EnumValue Name="gnu++2c"
                   DisplayName="C++2C (C++26, GNU extensions)"
                   Switch="std=gnu++2c" />
        <!-- Not in Zig 0.16.0, ain't nobody using C++29 anyway -->
        <!--<EnumValue Name="c++2d"
                   DisplayName="C++2D (C++29)"
                   Switch="std=c++2d" />
        <EnumValue Name="gnu++2d"
                   DisplayName="C++2D (C++29, GNU extensions)"
                   Switch="std=gnu++2d" />-->
    </EnumProperty>
    <StringListProperty Name="PreprocessorDefinitions"
                        DisplayName="Preprocessor Definitions"
                        Description="Defines a preprocessing symbols for your source file. (-D)"
                        Switch="D "
                        Category="Preprocessor" />
    <StringListProperty Name="UndefinePreprocessorDefinitions"
                        DisplayName="Undefine Preprocessor Definitions"
                        Description="Specifies one or more preprocessor undefines.  (-U [macro])"
                        Switch="U "
                        Category="Preprocessor" />
    <BoolProperty Name="UndefineAllPreprocessorDefinitions"
                  DisplayName="Undefine All Preprocessor Definitions"
                  Description="Undefine all previously defined preprocessor values.  (-undef)"
                  Switch="undef"
                  Category="Preprocessor" />
    <EnumProperty Name="PrecompiledHeader"
                  DisplayName="Precompiled Header"
                  Description="Create/Use Precompiled Header:Enables creation or use of a precompiled header during the build."
                  Category="Precompiled Headers" >
        <EnumValue Name="Create" />
        <EnumValue Name="Use" />
        <EnumValue Name="NotUsing"
                   DisplayName="Not Using" />
    </EnumProperty>
    <StringProperty Name="PrecompiledHeaderFile"
                    DisplayName="Precompiled Header File"
                    Description="Specifies header file name to use for precompiled header file. This file will be also added to 'Forced Include Files' during build"
                     Category="Precompiled Headers" />
    <StringProperty Name="PrecompiledHeaderOutputFileDirectory"
                    DisplayName="Precompiled Header Output File Directory"
                    Description="Specifies the directory for the generated precompiled header. This directory will be also added to 'Additional Include Directories' during build"
                     Category="Precompiled Headers" />
    <EnumProperty Name="PrecompiledHeaderCompileAs"
                  DisplayName="Compile Precompiled Header As"
                  Description="Select compile language option for precompiled header file (-x c-header, -x c++-header)."
                  Category="Precompiled Headers" >
        <EnumValue Name="CompileAsC"
                   DisplayName="Compile as C"
                   Switch="x c-header" />
        <EnumValue Name="CompileAsCpp"
                   DisplayName="Compile as C++"
                   Switch="x c++-header" />
    </EnumProperty>
    <EnumProperty Name="CompileAs"
                  DisplayName="Compile As"
                  Description="Select compile language option for .c and .cpp files.  'Default' will detect based on .c or .cpp extention. (-x c, -x c++)"
                  Category="Language" >
        <EnumValue Name="Default" />
        <EnumValue Name="CompileAsC"
                   DisplayName="Compile as C"
                   Switch="x c-header" />
        <EnumValue Name="CompileAsCpp"
                   DisplayName="Compile as C++"
                   Switch="x c++-header" />
        <EnumValue Name="CompileAsAsm"
                   DisplayName="Compile as Assembly"
                   Switch="x assembler-with-cpp" />
    </EnumProperty>
    <StringListProperty Name="ForcedIncludeFiles"
                        DisplayName="Forced Include Files"
                        Description="one or more forced include files.     (-include [name])"
                        Switch="include "
                        Category="Advanced" />
  <StringProperty
     Name="AdditionalOptions"
     DisplayName="Additional Options"
     Description="Additional Options."
     Category="Command Line"
     F1Keyword="vc.project.AdditionalOptionsPage">
  </StringProperty>
</Rule>